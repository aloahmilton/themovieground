# ===========================================
# The Movie Ground – Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local or real keys to GitHub.

# TMDB (required for movies & TV)
# Get free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: TheSportsDB (sports section)
# Free test key is "3". For production get your own at https://www.thesportsdb.com
SPORTSDB_API_KEY=3

# Optional: Watch TV playlist. Only use channels you are authorized to stream.
IPTV_PLAYLIST_URL=https://iptv-org.github.io/iptv/index.m3u
