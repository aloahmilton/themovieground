# ===========================================
# The Movie Ground – Environment Variables
# ===========================================
# Copy to .env.local and fill in values.
# NEVER commit .env.local or real keys to GitHub.

# --- Required: movies & TV metadata ---
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# --- Optional: sports ---
# Free test key is "3". Production: https://www.thesportsdb.com
SPORTSDB_API_KEY=3

# --- Optional: legal live TV only ---
# HTTPS URL to an M3U/M3U8 playlist you are allowed to use
# (public domain, your own channels, or a licensed feed).
# Without this, /watch-tv stays unavailable — by design.
# IPTV_PLAYLIST_URL=https://example.com/licensed-playlist.m3u8
